# Copied into the ai-flow-secrets Secret by `make secrets` (kind) and read by `make dev-local`.
# GITHUB_TOKEN defaults to `gh auth token` when unset.
GITHUB_TOKEN=
LINEAR_API_KEY=
# The OpenAI-compatible endpoint the catalog's models run on (default: OpenAI)
# and its key. From inside kind, use an address the cluster can reach: not
# localhost (see docs/LOCAL-KIND.md).
LLM_BASE_URL=
LLM_API_KEY=
